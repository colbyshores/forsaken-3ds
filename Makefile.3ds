#
# Makefile.3ds - ForsakenX 3DS port using devkitPro
#
# Usage:
#   make -f Makefile.3ds                    # release build (citro3d, 1998 original)
#   make -f Makefile.3ds EDITION=remaster   # Remaster build: extra levels +
#                                           # Remaster's authoritative level
#                                           # ordering + new music tracks 11-19.
#                                           # Requires running both
#                                           # extract_assets.py (for the 1998
#                                           # ISO assets + tracks 02-10) and
#                                           # extract_remaster_levels.py (for
#                                           # the KPF levels + tracks 11-19).
#   make -f Makefile.3ds RENDERER=picagl    # picaGL fallback (no stereo 3D)
#   make -f Makefile.3ds DEBUG=1   # debug build (__3DS_DEBUG__ defined)
#                                   # enables: autoboot to Volcano level
#

# Debug flag — set to 1 to enable __3DS_DEBUG__ features
DEBUG ?= 0

# Renderer: citro3d (default — shipping CIA) or picagl (fallback, no stereo 3D)
RENDERER ?= citro3d

# Edition: original (default — 1998 game) or remaster (Forsaken Remastered
# levels + music). The remaster build still uses the 1998 ISO for UI assets
# (fonts, splash, decals) since the KPF lacks them — see README.
EDITION ?= original
# PERF_CAPTURE=1 adds in-memory frame/stage counters + teardown trace dump (hardware capture only)
PERF_CFLAGS := $(if $(PERF_CAPTURE),-DPERF_CAPTURE,)
# FIDELITY_DUMP=1 adds per-tick gameplay-state checksums to sdmc:/3ds/forsaken_fidelity.txt (A/B fidelity proof, harness builds only; under /3ds/ so the ATM HTTP allowlist serves it)
FIDELITY_CFLAGS := $(if $(FIDELITY_DUMP),-DFIDELITY_DUMP,)
# FRAMEDUMP=1 compiles in the triggerable framebuffer dump library
# (framedump.h): TCP trigger port + sdmc:/framedump_*.bmp + hash log.
# Harness builds only; default builds are unaffected.
FRAMEDUMP_CFLAGS := $(if $(FRAMEDUMP),-DFRAMEDUMP,)
# FRAMEDUMP_SELFTEST_AT=N auto-dumps once at frame N (emulator e2e:
# emulators do not bridge the trigger socket, so the self-test fires
# the capture path without network). Requires FRAMEDUMP=1.
SELFTEST_CFLAGS := $(if $(FRAMEDUMP_SELFTEST_AT),-DFRAMEDUMP_SELFTEST_AT=$(FRAMEDUMP_SELFTEST_AT),)
# NODE_SQDIST=1 selects the squared-distance candidate in UpdateNearestNodeSpecial (fidelity-gated experiment)
NODESQ_CFLAGS := $(if $(NODE_SQDIST),-DNODE_SQDIST,)
# FIDELITY_CHECKPOINTS=1 adds per-tick-interval hash checkpoints to the fidelity file (divergence localization)
FIDCK_CFLAGS := $(if $(FIDELITY_CHECKPOINTS),-DFIDELITY_CHECKPOINTS,)
# FIDELITY_CHECKPOINT_TICKS=N sets the checkpoint interval (default 250).
# Finer intervals (e.g. 60) give per-minute trajectory shape for A/B work.
FIDELITY_CHECKPOINT_TICKS ?= 250
FIDCKT_CFLAGS := $(if $(FIDELITY_CHECKPOINTS),-DFIDELITY_CHECKPOINT_TICKS=$(FIDELITY_CHECKPOINT_TICKS),)
# MODEL_VIS_CACHE=1 memoises the per-model visibility/clip-group predicate per camera (render-path optimisation, A/B gated)
VIS_CFLAGS := $(if $(MODEL_VIS_CACHE),-DMODEL_VIS_CACHE,)
# MODEL_BUCKET=1 (default) indexes models by clip group once per camera instead of re-walking the model list per group.
# 2026-11-14 stereo A/B on this branch: 88,443 -> 77,705/77,635us
# (-12%, two runs within 70us), fidelity byte-identical, draws/verts
# counts identical. (Mono was wall-neutral in the 2026-11-12 A/B/A;
# stereo doubles the traversal the bucket eliminates.) Converges
# with master's default. Set MODEL_BUCKET=0 to opt out.
MODEL_BUCKET ?= 1
BUCKET_CFLAGS := $(if $(filter 1,$(MODEL_BUCKET)),-DMODEL_BUCKET,)
# MODEL_BUCKET_VERIFY=1 adds an opt-in, correctness-only check that every
# MODEL_BUCKET group contains exactly the baseline-visible model sequence.
# It deliberately re-walks Models[] and is not a performance build.
MODEL_BUCKET_VERIFY ?= 0
# CHE_PREFILTER=1 enables the SoundInfo group pre-filter in CheckHitEnemy
# (checkenemy.c): skip enemies in groups with no direct visibility from the
# bullet's group before any per-enemy vector math. Default 1 (on): validated
# 2026-11-11 — fidelity A/B byte-identical on ramqan + bio-sphere, ramqan mono
# wall -7.7ms (-13%), host test tests/test_checkhitenemy.c green. Combat
# trajectories (firing input) remain uncovered by the bench — see the log.
CHE_PREFILTER ?= 1
# STRESS_SCRATCH_VERTS=N caps the scratch vertex arena at N verts (R02
# overflow-path stress; forces mid-frame splits every frame). Debug only,
# never ship: it destroys batching and the memo. 0 (default) = full arena.
STRESS_SCRATCH_VERTS ?= 0
# PERSIST_VERTS=1 (default) retains converted level-wall verts across
# frames (R05). Runtime-gated to mono (3D slider down) where it pays
# -8.6%; stereo keeps the memo-only path (persist is wall-flat there
# and only LSB-equivalent across eyes). Set 0 to disable entirely.
PERSIST_VERTS ?= 1
# QUADIDX_VERTS=1 (default) enables the TF04-A shared quad index table
# for canonical 4-vert billboard texgroups, runtime-gated to mono
# (slider down) like PERSIST_VERTS. Set 0 to disable entirely.
QUADIDX_VERTS ?= 1
ifeq ($(filter 1,$(QUADIDX_VERTS)),1)
ifneq ($(filter 1,$(STEREO_REPLAY)),1)
$(error QUADIDX_VERTS=1 requires STEREO_REPLAY=1)
endif
endif
STRESS_SCRATCH_CFLAGS := $(if $(filter-out 0,$(STRESS_SCRATCH_VERTS)),-DSTRESS_SCRATCH_VERTS=$(STRESS_SCRATCH_VERTS),)
CHE_PREFILTER_CFLAGS := $(if $(filter 1,$(CHE_PREFILTER)),-DCHE_PREFILTER,)
BUCKET_VERIFY_CFLAGS := $(if $(filter 1,$(MODEL_BUCKET_VERIFY)),-DMODEL_BUCKET_VERIFY,)
ifneq ($(filter 1,$(MODEL_BUCKET_VERIFY)),)
ifeq ($(filter 1,$(MODEL_BUCKET)),1)
else
$(error MODEL_BUCKET_VERIFY=1 requires MODEL_BUCKET=1)
endif
endif
# FRAME_INTERP=1 renders an extra frame at an interpolated camera between the previous and current frames (temporal interpolation prototype)
INTERPFRAME_CFLAGS := $(if $(FRAME_INTERP),-DFRAME_INTERP,)
# FRAME_INTERP_FORCE_MONO=1 disables stereo in the interpolation prototype build (measurement only)
FORCEMONO_CFLAGS := $(if $(FRAME_INTERP_FORCE_MONO),-DFRAME_INTERP_FORCE_MONO,)
# FRAME_INTERP_EXTRA_PRESENT=1 enables a true extra display transfer between simulation frames (experimental pacing)
INTERPPRESENT_CFLAGS := $(if $(FRAME_INTERP_EXTRA_PRESENT),-DFRAME_INTERP_EXTRA_PRESENT,)
# OG_PROFILE=1 uses exact N3DS 268MHz/L2-off CPU mode plus OG-shaped heap and texture tiers.
# RAM is approximated; platform/scheduler/GPU behavior remain New 3DS.
OGPROFILE_CFLAGS := $(if $(OG_PROFILE),-DFORSAKEN_OG_PROFILE -DFORSAKEN_HEAP_FIXED,)
# FRAME_INTERP_PROBE=1 renders each frame twice (identical state) to measure the
# floor cost of a CPU in-between pass — temporal-interpolation feasibility only.
INTERP_CFLAGS := $(if $(FRAME_INTERP_PROBE),-DFRAME_INTERP_PROBE,)

# ATM_PROFILING=1 links the shared ATM telemetry core and enables the fixed
# deterministic benchmark that publishes /3ds/atm_result.txt for the ATM
# harness (atm_prof.h / atm_prof_3ds.c). Harness builds only — never merged
# to a release branch. See perf/OPTIMIZATION-LOG.md Phase B.
ATM_PROFILING ?= 0
# Canonical shared ATM source (compiled in place, never copied, so the game,
# Rosalina and the host conformance test cannot diverge on bucket edges).
ATM_CORE_DIR ?= /mnt/nas/Development/netload_stub/sysmodules/rosalina
# Benchmark scenario: one level by NAME (slot indices differ between
# EDITION=original and EDITION=remaster), fixed warmup, fixed frame count.
ATM_BENCH_LEVEL  ?= ramqan
ATM_BENCH_FRAMES ?= 240
ATM_BENCH_WARMUP ?= 30
# 0 = force mono, 1 = force stereo. The physical 3D slider is a live analog
# input, so an unpinned slider cannot produce comparable runs.
ATM_BENCH_STEREO ?= 0
# ATM_BENCH_FIRE=1 holds primary fire for the whole bench (combat bench:
# live primaries, muzzle flashes, impacts, enemy reactions). Requires
# ATM_PROFILING=1 (refused otherwise: an always-firing dev build helps
# nobody). Cooldown/fire-rate stay engine-driven; this only pulls the
# trigger. Same discipline as the AUTOTEST_REMASTER hold in input_3ds.c,
# but without the level-sweep apparatus (dwell, chainload, DEBUG traces).
ATM_BENCH_FIRE ?= 0
# MEMO_VERIFY=1 converts live alongside every memo hit and memcmps against
# the recorded range (single-player stereo bench only). Proves the memoised
# vertices are what a live convert would produce; any mismatch increments
# the memo_mismatch counter. Validation-only: the ship build skips the
# redundant conversion.
MEMO_VERIFY ?= 0
# MEMO_VERIFY_FORENSICS=1 adds a one-shot first-mismatch boot_log line
# (key, offsets, first-differing word + both values). Debug only.
MEMO_VERIFY_FORENSICS ?= 0
# ATM_HEADLESS=1 restores the ATM-launch configuration (custom __appInit
# without aptInit + aptMainLoop-free main loop) for one-shot payloads that
# ATM launches while HOME stays foreground. Game benchmarks pushed via
# 3dslink to the live stub MUST leave this at 0: the stub chainloads the
# app as a proper NS foreground title, so normal init applies (proven by
# the framedump render-proof builds).
ATM_HEADLESS ?= 0
# STEREO_REPLAY=1 (default) enables the single-pass stereo vertex memo:
# the left eye records converted vertex ranges keyed by fill epoch; the
# right eye reuses them (never skips a draw — traversal, visibility,
# uniforms and HUD all run per eye). Measured -5 to -7% stereo wall on
# ramqan/Old 3DS, fidelity byte-identical. Known accepted limitation:
# animated texture surfaces can lag one UV step in the right eye
# (~9% of frame-15 pixels on lava/water-type surfaces; static content
# byte-identical) — R22 human A/B reviewed on hardware 2026-11-13 and
# accepted ("fine"). Set STEREO_REPLAY=0 to opt out. The old whole-list
# display replay this flag once gated was proven to draw wrong-eye
# geometry and is gone; see perf/OPTIMIZATION-LOG.md opt5/opt5b.
STEREO_REPLAY ?= 1

#---------------------------------------------------------------------------------
# Flag matrix — what each knob is for, and when it goes away.
# Nothing here is dead: every knob is live measurement infra, a shipped
# feature flag, or a placeholder with a named removal point. Do not
# purge flags for tidiness; each removal below is scheduled, not overdue.
#
# MEASUREMENT LOOP (every remaining A/B needs these; never ship, never drop):
#   ATM_PROFILING + ATM_BENCH_*  fixed bench + /3ds/atm_result.txt
#   (ATMBF=1 adds held primary fire: the combat bench. Same loop.)
#   FRAMEDUMP + FRAMEDUMP_SELFTEST_AT  pixel proof (stills + FNV log)
#   FIDELITY_DUMP (+FIDELITY_CHECKPOINTS)  gameplay-trajectory proof
#   FRAME_INTERP_PROBE  cost-of-second-render floor (M1 vehicle)
#   PERF_CAPTURE  per-stage breakdowns (shares only)
# SHIPPED FEATURES (default builds; gates cover):
#   CHE_PREFILTER=1, STEREO_REPLAY=1 (stereo memo, R22-accepted),
#   MODEL_BUCKET (flag-only), R1 helpers, GPU lighting path
# EXPERIMENTS (A/B only, default 0/off):
#   MODEL_VIS_CACHE, MODEL_BUCKET_VERIFY, NODE_SQDIST,
#   FRAME_INTERP* (prototype; EXTRA_PRESENT dies in M2 when the spec
#   scheduler replaces the prototype present path)
# COMPAT / ENV (not perf work):
#   OG_SIM (heap-only alias), OG_PROFILE, MALLOC/LINEAR_HEAP_MB,
#   AUTOTEST_REMASTER* (level-sweep fidelity vehicle), ATM_HEADLESS
#   (ATM-launched payloads only — NEVER for 3dslink/stub pushes),
#   DEBUG, RENDERER, EDITION, SLIM
# SCHEDULED REMOVALS (only at these points, not before):
#   FRAME_INTERP_EXTRA_PRESENT → M2 scheduler lands
#   STEREO_REPLAY → landed (R22-accepted default); flag stays as opt-out
#---------------------------------------------------------------------------------

#---------------------------------------------------------------------------------
# Environment
#---------------------------------------------------------------------------------

ifeq ($(strip $(DEVKITARM)),)
$(error "Please set DEVKITARM in your environment. export DEVKITARM=<path to>devkitARM")
endif
ifeq ($(strip $(DEVKITPRO)),)
$(error "Please set DEVKITPRO in your environment. export DEVKITPRO=<path to>devkitpro")
endif

include $(DEVKITARM)/3ds_rules

#---------------------------------------------------------------------------------
# Build configuration
#---------------------------------------------------------------------------------

# Root of the project sources
SRCDIR     := $(CURDIR)
TARGET     := forsaken3ds
BUILD      := build_3ds

# picaGL paths
PICAGL_DIR := $(SRCDIR)/picaGL
PICAGL_INC := $(PICAGL_DIR)/include

# portlibs
PORTLIBS   := $(DEVKITPRO)/portlibs/3ds

#---------------------------------------------------------------------------------
# Source files - exclude SDL/desktop/networking-specific files
#---------------------------------------------------------------------------------

EXCLUDE_SRC := \
	breakpad.cpp \
	render_d3d.cpp \
	main_sdl.c \
	input_sdl.c \
	input_dinput.c \
	sound_openal.c \
	sound_dsound.c \
	texture_sdl.c \
	texture_devil.c \
	render_gl2.c \
	render_gl3.c \
	render_disabled.c \
	net_enet.c \
	net_enet_2.c \
	net_tracker.c \
	private_address.c \
	lua_miniupnp.c \
	botai_actions.c \
	botai_path.c \
	botai_sensors.c \
	lua_bot.c


#---------------------------------------------------------------------------------
# Compiler / Linker flags
#---------------------------------------------------------------------------------

ARCH := -march=armv6k -mtune=mpcore -mfloat-abi=hard -mtp=soft

CFLAGS := $(ARCH) -O2 -Wall -Wno-unused-variable -Wno-unused-but-set-variable \
	-Wno-missing-braces -Wno-pointer-sign -Wno-sign-compare \
	-Wno-incompatible-pointer-types \
	-Wno-implicit-function-declaration \
	-Wno-implicit-int -Wno-int-conversion \
	-ffunction-sections -fdata-sections -fcommon \
	-fno-math-errno \
	$(PERF_CFLAGS) \
	$(FIDELITY_CFLAGS) \
	$(FIDCK_CFLAGS) \
	$(FIDCKT_CFLAGS) \
	$(FRAMEDUMP_CFLAGS) \
	$(SELFTEST_CFLAGS) \
	$(INTERP_CFLAGS) \
	$(INTERPFRAME_CFLAGS) \
	$(FORCEMONO_CFLAGS) \
	$(INTERPPRESENT_CFLAGS) \
	$(OGPROFILE_CFLAGS) \
	$(VIS_CFLAGS) \
	$(BUCKET_CFLAGS) \
	$(BUCKET_VERIFY_CFLAGS) \
	$(CHE_PREFILTER_CFLAGS) \
	$(STRESS_SCRATCH_CFLAGS) \
	$(NODESQ_CFLAGS) \
	-std=gnu99 \
	-D__3DS__ -DARM \
	-DBSP \
	-DTEXTURE_PNG \
	-DSOUND_SUPPORT \
	-DLUA_USE_APICHECK

ifeq ($(RENDERER),citro3d)
CFLAGS += -DRENDERER_C3D
# Hybrid GPU vertex lighting: shader does ambient + per-vertex point-light
# falloff + accumulation, replacing the per-vertex CPU dynamic-light loop
# in lights.c::XLight1Group. Validated on hardware; default-on for citro3d.
# picaGL builds keep CPU lighting since picaGL has no programmable shader.
CFLAGS += -DGPU_LIGHTING
EXCLUDE_SRC += render_gl1.c render_gl_shared.c
else
CFLAGS += -DGL=1
EXCLUDE_SRC += render_c3d.c
endif

ALL_SRC := $(notdir $(wildcard $(SRCDIR)/*.c))
CFILES  := $(filter-out $(EXCLUDE_SRC),$(ALL_SRC))
OFILES  := $(CFILES:.c=.o)

# C-with-classes phase 2 (AGENTS.md 9): root-level .cpp files compile as C++
# with the contract's language flags (-fno-exceptions -fno-rtti: the banned
# constructs must not merely be discouraged, they must not compile). There are
# none today; the machinery exists so the first converted module builds with
# the same flags the audit gate expects, and so the gates' "3DS build scope"
# claim stays true (a root-level .cpp is in scope for the gates, therefore it
# must be in the build).
CXXFILES := $(filter-out $(EXCLUDE_SRC),$(notdir $(wildcard $(SRCDIR)/*.cpp)))
CXXOFILES := $(CXXFILES:.cpp=.o)
OFILES += $(CXXOFILES)
# Link with the C++ driver when any C++ object exists: it pulls libstdc++ and
# the C++ startup bits the objects reference.
ifeq ($(strip $(CXXOFILES)),)
LINK_CC := $(CC)
else
LINK_CC := $(CXX)
endif
CXXFLAGS_ADD := -std=gnu++17 -fno-exceptions -fno-rtti -fno-threadsafe-statics

#
# __3DS_DEBUG__ is the unified diagnostic gate. When defined:
#   - god mode + all weapons + autoboot enabled (singleplayer.c)
#   - trace() writes to sdmc:/forsaken_trace.txt and dispatches via
#     svcOutputDebugString (main_3ds.c — release builds get an empty
#     body so call sites compile to nothing, no SD I/O on shipping CIAs)
#   - VERBOSE_TRACE-gated #ifdef blocks are activated (see below)
#
# Set it via `make DEBUG=1`. AUTOTEST_REMASTER=1 implies it (the sweep
# harness needs traces to record each level transition) and so does
# DEATH_SIM=1.
#
ifeq ($(DEBUG),1)
CFLAGS += -D__3DS_DEBUG__ -DVERBOSE_TRACE
endif

# DEBUG_AUTOBOOT_SLOT=N overrides the DEBUG-build autoboot target (which
# defaults to slot 0 / vol2). Useful for testing a specific level's boss
# rendering: e.g. DEBUG_AUTOBOOT_SLOT=19 boots biolab (Maldroid),
# DEBUG_AUTOBOOT_SLOT=18 boots munitions (DreadNaught). Independent of
# AUTOTEST_REMASTER (which has its own AUTOTEST_FIRST_LEVEL knob).
ifneq ($(DEBUG_AUTOBOOT_SLOT),)
CFLAGS += -DDEBUG_AUTOBOOT_SLOT=$(DEBUG_AUTOBOOT_SLOT)
endif

# DEBUG_WARP_TO_BOSS=1 - branch-local one-shot warp.
ifeq ($(DEBUG_WARP_TO_BOSS),1)
CFLAGS += -DDEBUG_WARP_TO_BOSS
endif

ifeq ($(EDITION),remaster)
CFLAGS += -DEDITION_REMASTER

# DEFEND2_TRACE=1 — focused CargoDrone trace lines to sdmc:/forsaken_boot.log:
# switch flips, drone-wait events, lift BGO start/end, drone state per lift.
ifeq ($(DEFEND2_TRACE),1)
CFLAGS += -DDEFEND2_TRACE
endif
endif

# AUTOTEST_REMASTER=1 is a hardware-iteration helper. With it set, the
# build autoboots into mission.dat[5] (defend2 — first new SP slot)
# and cycles through the rest of the SP campaign one minute per level,
# tracing each transition to sdmc:/forsaken_trace.txt and chain-loading
# back to sdmc:/3ds/netload_stub.3dsx after the last level. Used to
# validate Remaster levels without manual menu navigation.
ifeq ($(AUTOTEST_REMASTER),1)
# profiling branch: VERBOSE_TRACE dropped — per-line fsync (5-10 ms, P5)
# poisons the PERF_CAPTURE timings this build is meant to measure.
CFLAGS += -DAUTOTEST_REMASTER -D__3DS_DEBUG__
endif

# OG_PROFILE=1 is a development proxy for an Old-3DS profile on N3DS.
# Skips 804MHz/L2; caps malloc/linear heaps to the observed OG-app defaults
# (32+22 MB); selects the 256x texture pack even on a 96MB+ New region. CPU
# clock/cache is exact; RAM capacity is approximate; GPU, scheduler, memory
# bandwidth/latency and platform characteristics remain New 3DS. Do NOT report
# it as a real Old-3DS result. Override heap sizes with MALLOC_HEAP_MB=N
# LINEAR_HEAP_MB=N. OG_SIM is retained as the historical 30+30 heap-only mode.
ifeq ($(OG_PROFILE),1)
MALLOC_HEAP_MB ?= 32
LINEAR_HEAP_MB ?= 22
CFLAGS += -DFORSAKEN_OG_PROFILE -DFORSAKEN_HEAP_FIXED
endif
# OG_SIM=1 remains a heap-only compatibility alias (historical build usage).
ifeq ($(OG_SIM),1)
MALLOC_HEAP_MB ?= 30
LINEAR_HEAP_MB ?= 30
endif
ifdef MALLOC_HEAP_MB
CFLAGS += -DMALLOC_HEAP_MB=$(MALLOC_HEAP_MB)
endif
ifdef LINEAR_HEAP_MB
CFLAGS += -DLINEAR_HEAP_MB=$(LINEAR_HEAP_MB)
endif

# AUTOTEST_FIRST_LEVEL=N overrides the sweep's starting slot so we can
# resume a sweep from where the previous run failed without re-cycling
# already-validated levels. Pass on the make command line:
#   make ... AUTOTEST_REMASTER=1 AUTOTEST_FIRST_LEVEL=10
ifneq ($(AUTOTEST_FIRST_LEVEL),)
CFLAGS += -DAUTOTEST_FIRST_LEVEL=$(AUTOTEST_FIRST_LEVEL)
# (Force-rebuild rule for autotest_3ds.o is appended after `all:` below
# so it doesn't accidentally become the default target — putting an
# explicit rule with no commands before `all:` made make's first target
# `$(BUILD)/autotest_3ds.o`, breaking plain `make` for everyone.)
endif

# AUTOTEST_MAX_LEVELS_TO_SWEEP=N caps how many levels the sweep covers
# before chain-loading back. Default 32; reduce for focused diagnosis.
ifneq ($(AUTOTEST_MAX_LEVELS_TO_SWEEP),)
CFLAGS += -DAUTOTEST_MAX_LEVELS_TO_SWEEP=$(AUTOTEST_MAX_LEVELS_TO_SWEEP)
endif

# AUTOTEST_MS_PER_LEVEL=N overrides the per-level dwell (default 60000
# ms = 60s). Useful for fast smoke tests.
ifneq ($(AUTOTEST_MS_PER_LEVEL),)
CFLAGS += -DAUTOTEST_MS_PER_LEVEL=$(AUTOTEST_MS_PER_LEVEL)
endif

# ATM_BENCH_FIRE=1 without the bench is an always-firing dev build that
# helps nobody — refuse it (MODEL_BUCKET_VERIFY precedent).
# MEMO_VERIFY=1 converts live alongside every memo hit (see render_c3d.c)
# so it also requires the bench result channel for its mismatch counter.
ifeq ($(filter 1,$(MEMO_VERIFY)),1)
ifneq ($(ATM_PROFILING),1)
$(error MEMO_VERIFY=1 requires ATM_PROFILING=1)
endif
ifneq ($(filter 1,$(STEREO_REPLAY)),1)
$(error MEMO_VERIFY=1 requires STEREO_REPLAY=1)
endif
endif
ifeq ($(filter 1,$(ATM_BENCH_FIRE)),1)
ifneq ($(ATM_PROFILING),1)
$(error ATM_BENCH_FIRE=1 requires ATM_PROFILING=1)
endif
endif

# ATM_PROFILING=1 — see the knob block near the top of this file.
ifeq ($(ATM_PROFILING),1)
ifeq ($(wildcard $(ATM_CORE_DIR)/source/atm/atm_core.c),)
$(error ATM_PROFILING=1 needs $(ATM_CORE_DIR)/source/atm/atm_core.c — set ATM_CORE_DIR=<path to netload_stub/sysmodules/rosalina>)
endif
CFLAGS += -DATM_PROFILING -I$(ATM_CORE_DIR)/include
CFLAGS += -DATM_BENCH_LEVEL='"$(ATM_BENCH_LEVEL)"'
CFLAGS += -DATM_BENCH_FRAMES=$(ATM_BENCH_FRAMES)
CFLAGS += -DATM_BENCH_WARMUP=$(ATM_BENCH_WARMUP)
CFLAGS += -DATM_BENCH_STEREO=$(ATM_BENCH_STEREO)
CFLAGS += $(if $(filter 1,$(ATM_BENCH_FIRE)),-DATM_BENCH_FIRE,)
CFLAGS += $(if $(filter 1,$(MEMO_VERIFY)),-DMEMO_VERIFY,)
CFLAGS += $(if $(filter 1,$(MEMO_VERIFY_FORENSICS)),-DMEMO_VERIFY_FORENSICS,)
CFLAGS += $(if $(filter 1,$(MEMO_FORCE_MISS)),-DMEMO_FORCE_MISS,)
CFLAGS += $(if $(filter 1,$(MEMO_NO_COALESCE)),-DMEMO_COALESCE_SUBMIT=0,)
CFLAGS += $(if $(filter 1,$(QUADIDX_VERTS)),-DQUADIDX_VERTS,)
CFLAGS += $(if $(filter 1,$(PERSIST_VERTS)),-DPERSIST_VERTS,)
CFLAGS += $(if $(filter 1,$(ATM_HEADLESS)),-DATM_HEADLESS,)
CFLAGS += $(if $(filter 1,$(STEREO_REPLAY)),-DSTEREO_REPLAY,)
# Compiled from outside $(SRCDIR), so it needs an explicit rule (below) and
# cannot ride the $(SRCDIR)/%.c pattern. It is also deliberately outside the
# AGENTS.md gate scope: vendored shared ATM firmware, not Forsaken game code.
OFILES += atm_core.o
endif

# VERBOSE_TRACE=1 enables the TR() / TRMSG() macros in main.h. Lots of
# trace points get sprinkled through the loaders so a crash leaves the
# last reached point visible at the tail of sdmc:/forsaken_trace.txt.
# Tanks framerate + bloats the log — fine for crash bisection on
# hardware, off for production. Macros expand to do-nothing when this
# flag is absent so the trace points stay sprinkled in source without
# perf cost on shipping builds.
ifeq ($(VERBOSE_TRACE),1)
CFLAGS += -DVERBOSE_TRACE
endif

# DEATH_SIM=1 simulates the game-over (lose-all-lives) code path on
# boot. Autoboots into a level (vol2 by default) and after ~3 s of
# gameplay forces MyGameStatus = STATUS_QuitCurrentGame, exercising
# the same teardown→title chain as a real death sequence. Granular
# trace points fire across STATUS_QuitCurrentGame / ReleaseLevel /
# InitScene / InitView / InitTitle so a crash leaves the last reached
# point at the tail of sdmc:/forsaken_trace.txt. After the title
# screen is reachable for ~3 s, chain-loads back to netload_stub so
# the host can pull the trace via 3dslink. Diagnostic build only.
ifeq ($(DEATH_SIM),1)
CFLAGS += -DDEATH_SIM -D__3DS_DEBUG__ -DVERBOSE_TRACE
endif

# Include paths - note isystem for the source dir so #include <header.h> works
CFLAGS += -isystem $(SRCDIR) \
	-I$(SRCDIR) \
	-I$(PICAGL_INC) \
	-I$(PORTLIBS)/include \
	-I$(PORTLIBS)/include/lua5.1 \
	-I$(DEVKITPRO)/libctru/include

LDFLAGS := $(ARCH) -specs=3dsx.specs \
	-Wl,-Map,$(TARGET).map \
	-L$(PICAGL_DIR)/lib \
	-L$(PORTLIBS)/lib \
	-L$(DEVKITPRO)/libctru/lib

# Link order: picaGL before citro3d
ifeq ($(RENDERER),citro3d)
LIBS := -lcitro3d
else
LIBS := -lpicaGL -lcitro3d
endif
LIBS += -lctru -lpng -lz -llua5.1 -lm

#---------------------------------------------------------------------------------
# SMDH metadata
#---------------------------------------------------------------------------------

SMDH_ICON := $(SRCDIR)/assets/icon.png
ifeq ($(wildcard $(SMDH_ICON)),)
SMDH_ICON := $(DEVKITPRO)/libctru/default_icon.png
endif

#---------------------------------------------------------------------------------
# Targets
#---------------------------------------------------------------------------------

OUTPUT_ELF  := $(SRCDIR)/$(TARGET).elf
OUTPUT_3DSX := $(SRCDIR)/$(TARGET).3dsx
OUTPUT_SMDH := $(SRCDIR)/$(TARGET).smdh

# Physical romfs directory (no symlinks - 3dsxtool can't follow them)
ROMFS_STAGING := $(SRCDIR)/.romfs_staging
ROMFS_STAMP   := $(ROMFS_STAGING)/.stamp

# CIA-specific romfs staging excludes dspfirm.cdc. Nintendo's DSP
# firmware blob is bundled into the .3dsx for emulator convenience
# (ensure_dspfirm_on_sd() in sound_3ds.c auto-copies it to the virtual
# SD on first launch), but we don't ship it inside the CIA — CFW users
# installing on real hardware already have dspfirm.cdc on their SD from
# the standard DSP1 dump step, and shipping the blob in a redistributable
# archive is a licensing grey area.
# Hardlinked from ROMFS_STAGING so there's ~zero disk overhead.
CIA_ROMFS       := $(SRCDIR)/.romfs_staging_cia
CIA_ROMFS_STAMP := $(CIA_ROMFS)/.stamp

.PHONY: all clean romfs-clean

all: $(OUTPUT_3DSX)

# --- Build-flag stamp -------------------------------------------------------
# The -D flag set (PERF_CAPTURE, FIDELITY_DUMP, FIDELITY_CHECKPOINTS,
# NODE_SQDIST, AUTOTEST_*_REMASTER/FIRST_LEVEL/MAX_LEVELS...) changes object
# code but is invisible to the -MMD dependency files, so switching flags
# left stale objects that silently relinked wrong behavior (three incidents
# this program: 2026-10-26, ships.o + perf_capture_3ds.o link failures and
# a stale-binary push). This stamp records the flag set; when it changes,
# the stamp file is rewritten with a fresh mtime, and because every object
# depends on the stamp, make rebuilds the whole tree. Unchanged flags keep
# the old stamp mtime, so normal incremental builds are untouched.
STAMP := $(BUILD)/.dflags.stamp
STAMP_CONTENT := PERF=$(PERF_CAPTURE)|FID=$(FIDELITY_DUMP)|FIDCK=$(FIDELITY_CHECKPOINTS)|FIDCKT=$(FIDELITY_CHECKPOINT_TICKS)|FDMP=$(FRAMEDUMP)|SQDIST=$(NODE_SQDIST)|OGPROFILE=$(OG_PROFILE)|VIS=$(MODEL_VIS_CACHE)|BUCKET=$(MODEL_BUCKET)|BVERIFY=$(MODEL_BUCKET_VERIFY)|ITP=$(FRAME_INTERP_PROBE)|ITPF=$(FRAME_INTERP)|ITPM=$(FRAME_INTERP_FORCE_MONO)|ITPP=$(FRAME_INTERP_EXTRA_PRESENT)|OGSIM=$(OG_SIM)|MALLOC=$(MALLOC_HEAP_MB)|LINEAR=$(LINEAR_HEAP_MB)|AT=$(AUTOTEST_REMASTER)|ATF=$(AUTOTEST_FIRST_LEVEL)|ATM=$(AUTOTEST_MAX_LEVELS_TO_SWEEP)|ATMS=$(AUTOTEST_MS_PER_LEVEL)|ED=$(EDITION)|SLIM=$(SLIM)|ATMP=$(ATM_PROFILING)|ATML=$(ATM_BENCH_LEVEL)|ATMF=$(ATM_BENCH_FRAMES)|ATMW=$(ATM_BENCH_WARMUP)|ATMS3D=$(ATM_BENCH_STEREO)|ATMBF=$(ATM_BENCH_FIRE)|ATMMV=$(MEMO_VERIFY)|ATMMVF=$(MEMO_VERIFY_FORENSICS)|ATMMFM=$(MEMO_FORCE_MISS)|ATMNC=$(MEMO_NO_COALESCE)|PV=$(PERSIST_VERTS)|QI=$(QUADIDX_VERTS)|ATMH=$(ATM_HEADLESS)|STREP=$(STEREO_REPLAY)|FDMPST=$(FRAMEDUMP_SELFTEST_AT)|CHE=$(CHE_PREFILTER)|STS=$(STRESS_SCRATCH_VERTS)
$(STAMP): FORCE
	@mkdir -p $(BUILD)
	@printf '%s' '$(STAMP_CONTENT)' > $@.tmp
	@if cmp -s $@.tmp $@; then rm -f $@.tmp; else mv $@.tmp $@; echo "build flags changed -> full rebuild"; fi

# Force autotest_3ds.o to always recompile when AUTOTEST_FIRST_LEVEL is set,
# so a slot change picks up without manual `rm`. CFLAGS aren't tracked as
# deps by default. Defined AFTER `all:` so `make` with no target still
# resolves to `all` and not to this internal .o rule.
ifneq ($(AUTOTEST_FIRST_LEVEL),)
$(BUILD)/autotest_3ds.o: FORCE
endif
.PHONY: FORCE
FORCE: ;

# Compile PICA200 vertex shader and embed into a C header for source inclusion.
# render_c3d.c does `#include "render_c3d_shbin.h"` to get the shader bytecode
# baked into the binary. Without this rule, a developer who edited the .pica
# would see no behavioral change because picasso runs but xxd never gets called
SHADER_PICA   := $(SRCDIR)/shaders/render_c3d.v.pica
SHADER_SHBIN  := $(SRCDIR)/shaders/render_c3d.shbin
SHADER_HEADER := $(SRCDIR)/render_c3d_shbin.h

$(SHADER_SHBIN): $(SHADER_PICA)
	@echo "Compiling vertex shader $<..."
	@$(DEVKITPRO)/tools/bin/picasso -o $@ $<

$(SHADER_HEADER): $(SHADER_SHBIN)
	@echo "Generating $@..."
	@cd $(SRCDIR) && xxd -i shaders/render_c3d.shbin | \
	  sed 's/shaders_render_c3d_shbin/render_c3d_shbin/g' > render_c3d_shbin.h

# Force render_c3d.o to depend on the shader header so editing .pica triggers
# both the shader rebuild and the renderer source recompile.
$(BUILD)/render_c3d.o: $(SHADER_HEADER)

# Build a physical copy of romfs (resolving all symlinks) once
# After copying, lowercase all file/directory names so convert_path() lookups work
# (original game data has mixed-case Windows filenames; 3DS romfs is case-sensitive)
#
# Freshness check: a phony target compares the newest file under romfs/
# (following symlinks) against the stamp's mtime and deletes the stamp if
# anything is newer. That forces the real stamp rule below to rerun. We do
# this via a phony rule rather than listing all romfs files as prerequisites
# because the game assets contain filenames with literal spaces which Make's
# space-separated prerequisite list cannot express.
.PHONY: romfs-freshness-check
romfs-freshness-check:
	@if [ -f $(ROMFS_STAMP) ] && \
	   [ -z "$$(find -L $(SRCDIR)/romfs -type f -newer $(ROMFS_STAMP) -print -quit 2>/dev/null)" ] && \
	   [ -z "$$(find -L $(SRCDIR)/assets/level_orderings -type f -newer $(ROMFS_STAMP) -print -quit 2>/dev/null)" ]; then \
		: ; \
	else \
		rm -f $(ROMFS_STAMP) ; \
	fi

# Order-only dependency on the phony check — make runs the check first
# (which may delete the stamp if a source file is newer) but doesn't
# consider the phony's "always out of date" timestamp when deciding
# whether the stamp itself is up-to-date. Net result: restage only when
# the check deleted the stamp.
$(ROMFS_STAMP): | romfs-freshness-check
	@echo "Staging romfs data (this may take a while)..."
	@mkdir -p $(ROMFS_STAGING)
	@rsync -aL --delete --exclude='.stamp' $(SRCDIR)/romfs/ $(ROMFS_STAGING)/
	@echo "Converting BMP textures to PNG (level-specific + global)..."
	@# The 3DS texture loader (render_c3d.c::FSCreateTexture) substitutes
	@# a .png extension at lookup time, so the engine looks for <name>.png
	@# even when the data ships as <name>.bmp. Convert both per-level
	@# atlases AND the global UI/weapon/sprite atlas so neither falls
	@# through to "file not found" at runtime. Skipped: the per-level
	@# .bmp at the level root (banner — written as 256x128 .png by
	@# extract_remaster_levels.py's import_banners()).
	@cd $(ROMFS_STAGING) && \
	  find . \( -path '*/levels/*/textures/*.bmp' \
	         -o -path '*/levels/*/textures/*.BMP' \
	         -o -path '*/data/textures/*.bmp' \
	         -o -path '*/data/textures/*.BMP' \
	         -o -path '*/data/splash/*.bmp' \
	         -o -path '*/data/splash/*.BMP' \) | \
	  while read bmp; do \
	    d=$$(dirname "$$bmp"); b=$$(basename "$$bmp"); \
	    png=$$(echo "$$b" | sed 's/\.[bB][mM][pP]$$/.png/'); \
	    if [ ! -f "$$d/$$png" ]; then \
	      convert "$$bmp" -type TrueColor "PNG24:$$d/$$png" 2>/dev/null; \
	    fi; \
	  done
	@echo "Lowercasing romfs filenames..."
	@cd $(ROMFS_STAGING) && find . -depth -name '*[A-Z]*' | while read f; do \
		d=$$(dirname "$$f"); b=$$(basename "$$f"); lb=$$(echo "$$b" | tr 'A-Z' 'a-z'); \
		if [ "$$b" != "$$lb" ]; then \
			if [ -e "$$d/$$lb" ]; then \
				rm -rf "$$d/$$b"; \
			else \
				mv "$$d/$$b" "$$d/$$lb"; \
			fi; \
		fi; \
	done
ifeq ($(EDITION),remaster)
	@# EDITION=remaster: substitute Remaster's authoritative SP / MP
	@# orderings (from assets/level_orderings/) over the 1998 originals
	@# that came in via extract_assets.py. music_3ds.c's s_level_track[]
	@# is keyed on this 32-entry SP ordering when -DEDITION_REMASTER is
	@# set, so the substitution is mandatory — fail the build if either
	@# source file is missing rather than silently producing a CIA whose
	@# level menu and music table disagree.
	@echo "Applying EDITION=remaster level orderings..."
	@LDIR=$(ROMFS_STAGING)/data/levels; SDIR=$(SRCDIR)/assets/level_orderings; \
	if [ ! -f $$SDIR/mission.dat ] || [ ! -f $$SDIR/battle.dat ]; then \
		echo "ERROR: $$SDIR/{mission,battle}.dat missing. These should be tracked in git; if you've just rebased a stale branch, run 'git checkout assets/level_orderings/'." >&2; exit 1; \
	fi; \
	cp -f $$SDIR/mission.dat $$LDIR/mission.dat; \
	cp -f $$SDIR/battle.dat  $$LDIR/battle.dat
endif
	@echo "Placing .keep files so makerom doesn't strip empty critical dirs..."
	@# missing_folders() in main.c requires all four to exist. The .3dsx
	@# ships fine because 3dsxtool preserves empty directories; makerom
	@# strips them. A tiny .keep file guarantees the dir survives the
	@# romfs pack on both paths. convert_path() lowercases lookups, and
	@# the lowercase step above lowercases staged names, so these literal
	@# lowercase folder names are all the game will ever look for.
	@for d in configs data pilots scripts; do \
		mkdir -p $(ROMFS_STAGING)/$$d; \
		touch $(ROMFS_STAGING)/$$d/.keep; \
	done
	@touch $(ROMFS_STAMP)

# CIA romfs: hardlinked mirror of the main staging minus dspfirm.cdc.
# --link-dest plus --delete make this idempotent and near-free.
$(CIA_ROMFS_STAMP): $(ROMFS_STAMP)
	@echo "Staging CIA romfs (excludes dspfirm.cdc)..."
	@mkdir -p $(CIA_ROMFS)
	@rsync -a --delete --link-dest=$(ROMFS_STAGING) \
		--exclude='.stamp' --exclude='dspfirm.cdc' \
		$(ROMFS_STAGING)/ $(CIA_ROMFS)/
	@touch $(CIA_ROMFS_STAMP)

$(OUTPUT_SMDH):
	@echo "Creating SMDH..."
	smdhtool --create "Forsaken" "3DS port of ForsakenX" "ForsakenX" $(SMDH_ICON) $@

ifeq ($(SLIM),1)
# SLIM=1: build a tiny .3dsx (no embedded romfs) plus a separate
# forsaken.romfs file. Used for the iteration loop — push the small
# .3dsx via 3dslink (~5 MB / ~12 sec) and keep the romfs uploaded
# once at sdmc:/3ds/forsaken/forsaken.romfs. The engine's
# platform_init() prefers the SD romfs over the embedded one.
$(OUTPUT_3DSX): $(OUTPUT_ELF) $(OUTPUT_SMDH) $(ROMFS_STAMP) forsaken.romfs
	@echo "Creating slim 3DSX (no embedded romfs)..."
	3dsxtool $< $@ --smdh=$(OUTPUT_SMDH)

forsaken.romfs: $(ROMFS_STAMP)
	@echo "Building standalone forsaken.romfs..."
	$(DEVKITPRO)/tools/bin/mkromfs3ds $(ROMFS_STAGING) $@
else
$(OUTPUT_3DSX): $(OUTPUT_ELF) $(OUTPUT_SMDH) $(ROMFS_STAMP)
	@echo "Creating 3DSX..."
	3dsxtool $< $@ --smdh=$(OUTPUT_SMDH) --romfs=$(ROMFS_STAGING)
endif

$(OUTPUT_ELF): $(addprefix $(BUILD)/,$(OFILES))
	@echo "Linking $(notdir $@)..."
	$(LINK_CC) $(LDFLAGS) $^ $(LIBS) -o $@

$(BUILD)/%.o: $(SRCDIR)/%.c $(STAMP)
	@echo $(notdir $<)
	@mkdir -p $(BUILD)
	$(CC) -MMD -MP -MF $(BUILD)/$*.d $(CFLAGS) -c $< -o $@

# C++ translation units (phase 2). Same numeric flags as C -- the contract
# applies to both -- plus the language flags AGENTS.md 9 requires. -std=gnu99
# and -fcommon are C-only spellings: gnu99 would override the C++ standard
# if it came last, and -fcommon is the C default GCC already rejects in C++.
CXX_BASE_FLAGS := $(filter-out -std=gnu99 -fcommon,$(CFLAGS))
$(BUILD)/%.o: $(SRCDIR)/%.cpp $(STAMP)
	@echo $(notdir $<)
	@mkdir -p $(BUILD)
	$(CXX) -MMD -MP -MF $(BUILD)/$*.d $(CXX_BASE_FLAGS) $(CXXFLAGS_ADD) -c $< -o $@

# Shared ATM telemetry core, compiled from the canonical netload_stub tree in
# place (explicit rule: it is outside $(SRCDIR), so the pattern rule above
# cannot reach it). Same numeric flags as the game; -MMD keeps it honest.
$(BUILD)/atm_core.o: $(ATM_CORE_DIR)/source/atm/atm_core.c $(STAMP)
	@echo "$(notdir $<) [shared ATM core]"
	@mkdir -p $(BUILD)
	$(CC) -MMD -MP -MF $(BUILD)/atm_core.d $(CFLAGS) -c $< -o $@

clean:
	@echo "Cleaning 3DS build..."
	@rm -rf $(BUILD) $(OUTPUT_ELF) $(OUTPUT_3DSX) $(OUTPUT_SMDH) $(TARGET).map $(OUTPUT_BNR) $(OUTPUT_CIA) $(OUTPUT_CIA_ALT) $(OUTPUT_CIA_HIMEM) $(OUTPUT_CIA_HIMEM_ALT)

romfs-clean:
	@echo "Cleaning romfs staging..."
	@rm -rf $(ROMFS_STAGING) $(CIA_ROMFS)

# ─── CIA build (for installable home-menu title) ──────────────────────
# Requires:
#   - tools/makerom    (downloaded by `make tools-fetch`)
#   - tools/bannertool ("                                          ")
#   - assets/icon.png         (48x48 home-menu icon)
#   - assets/banner.png       (256x128 home-menu banner)
#   - assets/banner.wav       (silent or short clip, used as banner audio)
#   - assets/forsaken.rsf     (makerom config)
#   - romfs/dspfirm.cdc       (extracted to sdmc:/3ds/ on first boot by
#                              sound_init() so users don't need to dump it
#                              separately. Personal-use only — Nintendo
#                              firmware blob.)

TOOLS_DIR    := $(SRCDIR)/tools
MAKEROM      := $(TOOLS_DIR)/makerom
BANNERTOOL   := $(TOOLS_DIR)/bannertool

ASSETS_DIR   := $(SRCDIR)/assets
ICON_PNG     := $(ASSETS_DIR)/icon.png
BANNER_PNG   := $(ASSETS_DIR)/banner.png
BANNER_WAV   := $(ASSETS_DIR)/banner.wav
RSF_FILE     := $(ASSETS_DIR)/forsaken.rsf

OUTPUT_BNR   := $(SRCDIR)/$(TARGET).bnr
OUTPUT_CIA   := $(SRCDIR)/$(TARGET).cia

.PHONY: cia tools-fetch

# Fetch makerom + bannertool into ./tools/ (one-time setup for CIA builds)
tools-fetch:
	@mkdir -p $(TOOLS_DIR)
	@if [ ! -x $(MAKEROM) ]; then \
		echo "Downloading makerom..."; \
		cd $(TOOLS_DIR) && \
		wget -q -O makerom.zip "https://github.com/3DSGuy/Project_CTR/releases/download/makerom-v0.18.4/makerom-v0.18.4-ubuntu_x86_64.zip" && \
		unzip -o makerom.zip && chmod +x makerom && rm makerom.zip; \
	fi
	@if [ ! -x $(BANNERTOOL) ]; then \
		echo "Downloading bannertool..."; \
		cd $(TOOLS_DIR) && \
		wget -q -O bannertool.zip "https://github.com/carstene1ns/3ds-bannertool/releases/download/1.2.2/bannertool-1.2.2-linux.zip" && \
		unzip -o bannertool.zip && \
		mv bannertool-1.2.2-linux/bannertool ./bannertool && \
		chmod +x bannertool && rm -rf bannertool.zip bannertool-1.2.2-linux; \
	fi
	@echo "tools ready: $(MAKEROM) + $(BANNERTOOL)"

$(OUTPUT_BNR): $(BANNER_PNG) $(BANNER_WAV) | tools-fetch
	@echo "Creating banner..."
	$(BANNERTOOL) makebanner -i $(BANNER_PNG) -a $(BANNER_WAV) -o $@

$(OUTPUT_CIA): $(OUTPUT_ELF) $(OUTPUT_SMDH) $(OUTPUT_BNR) $(RSF_FILE) $(CIA_ROMFS_STAMP) | tools-fetch
	@echo "Building CIA..."
	$(MAKEROM) -f cia -o $@ \
		-rsf $(RSF_FILE) \
		-target t -exefslogo \
		-elf $(OUTPUT_ELF) \
		-icon $(OUTPUT_SMDH) \
		-banner $(OUTPUT_BNR) \
		-DAPP_ROMFS=$(CIA_ROMFS)
	@echo "CIA written: $@"
	@echo "Install on a 3DS via FBI (open the .cia → Install)."

cia: $(OUTPUT_CIA)

-include $(wildcard $(BUILD)/*.d)

# ─── Release pipeline ────────────────────────────────────────────────
#
# `make -f Makefile.3ds release` produces three artifacts ready to
# upload to archive.org, all from a clean tree:
#
#   forsaken3ds.cia            — UniqueId 0xff4ba (current shipping)
#   forsaken3ds_alt.cia        — UniqueId 0xff4bb (alternate ID for
#                                Title-ID-collision recovery: if a user
#                                has another homebrew on 0xff4ba already,
#                                they install this variant instead)
#   forsaken3ds.3dsx           — fat build with full romfs (dspfirm.cdc
#                                bundled, auto-stages on first boot).
#                                For Homebrew Launcher users who do not
#                                want a CIA install.
#
# **HARD RULE — DO NOT VIOLATE**:
#   Production builds MUST NOT include any debug flag. The release
#   target asserts this and refuses to build if any of the following
#   are set in the environment or on the make command line:
#
#       DEBUG, AUTOTEST_REMASTER, DEBUG_AUTOBOOT_SLOT,
#       DEBUG_WARP_TO_BOSS, DEATH_SIM, AUTOBOOT_SP, DEBUG_RAMQAN_FIRE
#
#   Background: 2026-05-07 we shipped a CIA with AUTOTEST_REMASTER baked
#   in because a previous diagnostic build's .o files were reused
#   without `make clean`. Players got a level-cycler instead of a game.
#   The release target guards against that with three layers:
#     1. Refuse to run if any debug flag env var is set
#     2. Force `make clean` before invoking the production builds
#     3. arm-none-eabi-strings | grep "AUTOTEST:|autoboot:|autotest_tick"
#        must return zero hits before any artifact is allowed to upload
#
# Add new debug flags to the FORBIDDEN_FLAGS list when you introduce
# them. Better to over-block than ship another sweep build by accident.

FORBIDDEN_FLAGS := DEBUG AUTOTEST_REMASTER DEBUG_AUTOBOOT_SLOT \
                   DEATH_SIM AUTOBOOT_SP DEBUG_RAMQAN_FIRE

OUTPUT_CIA_ALT      := $(SRCDIR)/$(TARGET)_alt.cia
RSF_FILE_ALT        := $(BUILD)/forsaken_alt.rsf

.PHONY: release release-check $(OUTPUT_CIA_ALT)

release-check:
	@echo "[release] Verifying no debug flags are set..."
	@for f in $(FORBIDDEN_FLAGS); do \
		v=$$(eval echo \$$$$f); \
		if [ -n "$$v" ]; then \
			echo "[release] ABORT: forbidden flag $$f=$$v is set."; \
			echo "[release] Production builds must have NO debug flags."; \
			echo "[release] Unset it in your environment and re-run."; \
			exit 1; \
		fi; \
	done
	@echo "[release] Clean flag environment confirmed."

# Generate alt RSF by substituting the UniqueId. Idempotent — the
# rule re-runs whenever the source RSF changes.
$(RSF_FILE_ALT): $(RSF_FILE) | $(BUILD)
	@mkdir -p $(BUILD)
	@sed 's/UniqueId\s*:\s*0xff4ba/UniqueId                : 0xff4bb/' \
		$(RSF_FILE) > $(RSF_FILE_ALT)
	@echo "[release] Generated alt RSF with UniqueId 0xff4bb"

# Alt CIA: same ELF + assets as the primary CIA, just a different
# UniqueId. Builds standalone — does not depend on the primary CIA
# rule, so `make release` can build both in parallel.
$(OUTPUT_CIA_ALT): $(OUTPUT_ELF) $(OUTPUT_SMDH) $(OUTPUT_BNR) $(RSF_FILE_ALT) $(CIA_ROMFS_STAMP) | tools-fetch
	@echo "[release] Building alt CIA (UniqueId 0xff4bb)..."
	$(MAKEROM) -f cia -o $@ \
		-rsf $(RSF_FILE_ALT) \
		-target t -exefslogo \
		-elf $(OUTPUT_ELF) \
		-icon $(OUTPUT_SMDH) \
		-banner $(OUTPUT_BNR) \
		-DAPP_ROMFS=$(CIA_ROMFS)
	@echo "[release] Alt CIA written: $@"


#---------------------------------------------------------------------------------
# HIMEM build: opt-in "use-at-your-own-risk" CIA that requests the OG
# HIMEM grant (`SystemMode: 96MB`).  For users with HIMEM-capable HOME
# menus who want full 512² textures on OG.  Uses the SAME ELF + romfs
# as the unified primary — only the RSF differs (and the UniqueId).
# Auto-detection in main_3ds.c / render_c3d.c picks the right heap
# sizes + texture pack based on the granted region.
# UniqueIds 0xff4be (primary) / 0xff4bf (alt).
#---------------------------------------------------------------------------------
OUTPUT_CIA_HIMEM     := $(SRCDIR)/$(TARGET)_himem.cia
OUTPUT_CIA_HIMEM_ALT := $(SRCDIR)/$(TARGET)_himem_alt.cia
RSF_FILE_HIMEM       := $(ASSETS_DIR)/forsaken_himem.rsf
RSF_FILE_HIMEM_ALT   := $(BUILD)/forsaken_himem_alt.rsf

.PHONY: $(OUTPUT_CIA_HIMEM) $(OUTPUT_CIA_HIMEM_ALT)

# Generate the HIMEM alt RSF by substituting the UniqueId — same
# pattern as the LOMEM and unified-alt rules.
$(RSF_FILE_HIMEM_ALT): $(RSF_FILE_HIMEM) | $(BUILD)
	@mkdir -p $(BUILD)
	@sed 's/UniqueId\s*:\s*0xff4be/UniqueId                : 0xff4bf/' \
		$(RSF_FILE_HIMEM) > $(RSF_FILE_HIMEM_ALT)
	@echo "[release] Generated HIMEM alt RSF with UniqueId 0xff4bf"

# HIMEM primary CIA — UniqueId 0xff4be.  Reuses the unified ELF + the
# unified CIA_ROMFS staging (both texture packs); the engine picks
# 512² at runtime because the HIMEM grant lifts region_size into the
# 96 MB tier.
$(OUTPUT_CIA_HIMEM): $(OUTPUT_ELF) $(OUTPUT_SMDH) $(OUTPUT_BNR) $(RSF_FILE_HIMEM) $(CIA_ROMFS_STAMP) | tools-fetch
	@echo "[release] Building HIMEM CIA (UniqueId 0xff4be — opt-in)..."
	$(MAKEROM) -f cia -o $@ \
		-rsf $(RSF_FILE_HIMEM) \
		-target t -exefslogo \
		-elf $(OUTPUT_ELF) \
		-icon $(OUTPUT_SMDH) \
		-banner $(OUTPUT_BNR) \
		-DAPP_ROMFS=$(CIA_ROMFS)
	@echo "[release] HIMEM CIA written: $@"

# HIMEM alt CIA — UniqueId 0xff4bf, same ELF + assets.
$(OUTPUT_CIA_HIMEM_ALT): $(OUTPUT_ELF) $(OUTPUT_SMDH) $(OUTPUT_BNR) $(RSF_FILE_HIMEM_ALT) $(CIA_ROMFS_STAMP) | tools-fetch
	@echo "[release] Building HIMEM alt CIA (UniqueId 0xff4bf)..."
	$(MAKEROM) -f cia -o $@ \
		-rsf $(RSF_FILE_HIMEM_ALT) \
		-target t -exefslogo \
		-elf $(OUTPUT_ELF) \
		-icon $(OUTPUT_SMDH) \
		-banner $(OUTPUT_BNR) \
		-DAPP_ROMFS=$(CIA_ROMFS)
	@echo "[release] HIMEM alt CIA written: $@"


# Production 3dsx: rebuilds $(OUTPUT_3DSX) using CIA_ROMFS (no
# dspfirm.cdc, full game assets) so the file is safe to
# redistribute. The dev default (make) still bundles dspfirm
# for emulator convenience; the release target overwrites that
# as a deliberate terminal step inside the clean tree.
.PHONY: release-3dsx
release-3dsx: $(OUTPUT_ELF) $(OUTPUT_SMDH) $(CIA_ROMFS_STAMP)
	@echo "[release] Re-creating 3dsx with CIA romfs (no dspfirm)..."
	@rm -f $(OUTPUT_3DSX)
	3dsxtool $(OUTPUT_ELF) $(OUTPUT_3DSX) --smdh=$(OUTPUT_SMDH) --romfs=$(CIA_ROMFS)
	@echo "[release] Production 3dsx written: $(OUTPUT_3DSX)"

# Strings-grep sanity check. Catches any debug-flag string that snuck
# into the binary (defense in depth — release-check blocks the env,
# this catches a stale .o that bypassed the clean somehow). Runs
# AFTER all artifacts build so a fresh ELF is on disk.
.PHONY: release-strings-check
release-strings-check: $(OUTPUT_ELF)
	@echo "[release] Sanity-grepping production ELF for debug strings..."
	@n=$$(arm-none-eabi-strings $(OUTPUT_ELF) | grep -cE "AUTOTEST:|autoboot:|autotest_tick|DEATH_SIM|DEBUG_RAMQAN" || true); \
	if [ "$$n" != "0" ]; then \
		echo "[release] ABORT: $$n debug-flag strings present in $(OUTPUT_ELF)."; \
		echo "[release] Aborting before any artifact ships. Investigate."; \
		exit 1; \
	fi; \
	echo "[release] $(OUTPUT_ELF) is clean ✓"
# Top-level release target. Forces a clean build first so no stale .o
# files survive from previous diagnostic runs.
release: release-check
	@echo "[release] Running 'make clean' to guarantee fresh .o files..."
	@$(MAKE) -f Makefile.3ds clean
	@echo "[release] Building unified primary + alt CIA + dspfirm-less 3dsx..."
	@$(MAKE) -f Makefile.3ds RENDERER=citro3d EDITION=remaster \
		$(OUTPUT_CIA) $(OUTPUT_CIA_ALT) release-3dsx
	@echo "[release] Building HIMEM opt-in CIAs (primary + alt)..."
	@$(MAKE) -f Makefile.3ds RENDERER=citro3d EDITION=remaster \
		$(OUTPUT_CIA_HIMEM) $(OUTPUT_CIA_HIMEM_ALT)
	@echo "[release] Final sanity-grep on production ELF..."
	@$(MAKE) -f Makefile.3ds release-strings-check
	@echo
	@echo "============================================================"
	@echo "[release] DONE — five artifacts ready for archive.org:"
	@ls -lh $(OUTPUT_3DSX) \
		$(OUTPUT_CIA) $(OUTPUT_CIA_ALT) \
		$(OUTPUT_CIA_HIMEM) $(OUTPUT_CIA_HIMEM_ALT) 2>/dev/null
	@echo
	@echo "[release] SHA1 sums:"
	@sha1sum $(OUTPUT_3DSX) \
		$(OUTPUT_CIA) $(OUTPUT_CIA_ALT) \
		$(OUTPUT_CIA_HIMEM) $(OUTPUT_CIA_HIMEM_ALT) 2>/dev/null
	@echo
	@echo "[release] Production 3dsx is dspfirm-free (Nintendo firmware blob"
	@echo "[release] excluded — archive.org distribution safe)."
	@echo
	@echo "[release] Artifact roles:"
	@echo "  forsaken3ds.cia          — UNIFIED primary (recommended default;"
	@echo "                             auto-detects OG vs N3DS, picks 256² or 512²)"
	@echo "  forsaken3ds_alt.cia      — UNIFIED alt (title-slot collision fallback)"
	@echo "  forsaken3ds_himem.cia    — HIMEM opt-in (may not boot on all OG;"
	@echo "                             OG users with working HIMEM grant get 512²)"
	@echo "  forsaken3ds_himem_alt.cia — HIMEM alt"
	@echo "  forsaken3ds.3dsx         — HBL (dev iteration, not for general install)"
	@echo "============================================================"
