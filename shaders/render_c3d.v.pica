; render_c3d.v.pica — Forsaken citro3d vertex shader.
;
; === "Vertex Frame Gen" — two-part smoothing system ===
;
; This shader is one half of Forsaken 3DS's "Vertex Frame Gen" feature
; (toggled via Pause → 3DS Visual Settings → Vertex Frame Gen).  The full
; system has two components:
;
;   1. GPU morph-target lerp (THIS SHADER, v3 attribute path)
;      Animated model vertices (ships, enemies, pickups) are stored as two
;      keyframes: "from_pos" (v0) from the locked VBO (current anim frame)
;      and "to_pos" (v3) written into originalVerts by InterpFrames each
;      tick.  The shader lerps between them using interp_alpha (c34).
;      This replaces the per-vertex CPU lerp loop in InterpFrames that was
;      the single most expensive operation on the OG 3DS ARM11 at 268MHz.
;      Formula: pos = from + (to - from) * alpha
;               alpha=0 → from_pos (non-animated or VFG off)
;               alpha=1 → to_pos   (fully interpolated)
;
;   2. CPU camera temporal smoothing (render_c3d.c upload_matrices)
;      The view matrix is lerped element-by-element between the previous
;      frame's camera and the current frame's camera before composing
;      view×proj.  This makes world geometry glide smoothly rather than
;      snapping each frame, complementing the per-model vertex smoothing
;      above.  Done on the CPU before this shader runs; the projection
;      uniform (c0..c3) already contains the smoothed view×proj.
;
; Together these make every moving object AND the camera itself transition
; smoothly between game-logic ticks, giving the appearance of sub-tick
; temporal resolution using only 4 extra shader instructions and a handful
; of CPU float ops per frame.
;
; === Hybrid GPU vertex lighting ===
;
; Full MVP transform + ambient + per-vertex point-light contribution.
; Replaces the per-vertex CPU dynamic-light loop in lights.c::XLight1Group
; for the level mesh path, and XLightMxaloadHeader / XLightMxloadHeader
; for model meshes.
;
; Uniforms (register layout matches render_c3d.c UNIFORM_* defines):
;   projection[0..3]  (c0..c3)   — view × proj, with PICA depth remap,
;                                   90° screen rotation, AND camera temporal
;                                   smoothing applied (see component 2 above)
;   modelView[0..3]   (c4..c7)   — model→world (= identity for level
;                                   mesh, real model transform for
;                                   animated/static model meshes)
;   ambient           (c8)       — .xyz = ambient color, .w unused
;   light_count       (c9)       — .x = active light count (0..8)
;   lights[24]        (c10..c33) — 8 lights × 3 fvec4
;     light[3i+0] = (Pos.x, Pos.y, Pos.z, invSizeSq)  ; CPU pre-divides
;     light[3i+1] = (r, g, b, type)                    ; type 0=point
;     light[3i+2] = (Dir.x, Dir.y, Dir.z, CosArc)      ; reserved for spot
;   interp_alpha[1]   (c34)      — .x = morph-target lerp factor (0..1)
;                                   0 = show from_pos (non-animated / VFG off)
;                                   1 = show to_pos   (fully interpolated)
;
; Inputs:  v0=from_pos, v1=baked color (rgba 0..1), v2=texcoord
;          v3=to_pos (only valid when interp_alpha > 0, i.e. animated draws)
; Outputs: outpos (clip), outclr (baked+lights, saturated), outtc0
;
; Instruction count: ~92 ops of PICA200's 96-instruction vshader limit.

; Uniforms — register layout pinned via API uniform-name resolution
.fvec projection[4]
.fvec modelView[4]
.fvec ambient[1]
.fvec light_count[1]
.fvec lights[24]
.fvec interp_alpha[1]  ; c34 — .x = morph-target lerp factor (0..1)
                       ;        0 = show from_pos (non-animated), 1 = show to_pos

; Constants
.constf myconst(0.0, 1.0, -1.0, 0.0)
.alias  zeros myconst.xxxx
.alias  ones  myconst.yyyy

; Outputs
.out outpos position
.out outclr color
.out outtc0 texcoord0
.out outnq  normalquat   ; per-vertex quat for fragment-lighting (objects)
.out outview view         ; view vector for fragment-lighting

; Inputs
.alias inpos v0   ; from_pos (all draws) — "from" keyframe for animated models
.alias inclr v1
.alias intex v2
.alias into_pos v3  ; to_pos  — "to"   keyframe; only valid when interp_alpha > 0

.proc main
	; GPU morph-target lerp: lerp(from_pos, to_pos, interp_alpha.x)
	; For non-animated draws interp_alpha = 0, result = from_pos = inpos.
	; For animated draws InterpFrames sets interp_alpha = Interp (0..1),
	; from_pos = FromFrame positions, to_pos = ToFrame positions.
	; PICA200 constraint: two v-regs can't both be src in one instruction;
	; stage into_pos through r12 first.
	mov r12.xyz, into_pos                   ; r12 = to_pos (v3 → temp)
	add r12.xyz, r12, -inpos                ; r12 = to - from
	mul r12.xyz, interp_alpha[0].xxxx, r12  ; r12 = (to-from)*alpha
	add r0.xyz, inpos, r12                  ; r0 = from + (to-from)*alpha
	mov r0.w,   ones

	; r1 = modelView * r0 — world-space vertex position
	;   Level mesh: modelView = identity, so r1 == r0 == inpos.
	;   Animated/static model: modelView = real model→world transform.
	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0
	dp4 r1.w, modelView[3], r0

	; outpos = projection * r1 = (view*proj) * world * inpos = MVP * inpos
	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1

	; --- Object Phong support: per-vertex tangent-frame quat + view ---
	; For object draws (modelView != identity), use vertex position as
	; a proxy for the surface normal — works for the convex / spherical
	; models in Forsaken (ships, enemies, crates, pickups). For walls
	; (modelView = identity) the result is bogus but harmless: the wall
	; TexEnv path doesn't bind the LightEnv, so the normalquat is never
	; consumed. Saves us from wiring a per-vertex normal attribute.
	;
	; r7 = (inpos.xyz, 0) — direction from model origin to vertex
	mov r7.xyz, inpos
	mov r7.w,   zeros
	; r8.xyz = modelView * r7 — direction in world space
	dp4 r8.x, modelView[0], r7
	dp4 r8.y, modelView[1], r7
	dp4 r8.z, modelView[2], r7
	; Normalise r8 → world-space pseudo-normal N
	dp3 r9.x, r8, r8
	rsq r9.x, r9.x
	mul r8.xyz, r8.xyz, r9.x
	; Build quaternion that rotates Z+ to N:
	;   axis = (0,0,1) × N = (-N.y, N.x, 0)
	;   q = (axis, 1+N.z)  then normalise
	; Layout: (x, y, z, w) — vector part first, scalar last.
	mov r10.x, -r8.y
	mov r10.y, r8.x
	mov r10.z, zeros
	add r10.w, ones, r8.z
	dp4 r11.x, r10, r10
	rsq r11.x, r11.x
	mul outnq, r10, r11.x
	; outview = -r1 (vertex toward camera/origin in world space). The
	; fragment-lighting hardware refuses to fire if outview is unwritten.
	mov outview, -r1

	; --- Per-vertex lighting ---
	; r1.xyz is worldspace pos (level mesh and models alike). Lights
	; live in worldspace; distance math is now correct on both paths.
	;
	; Accumulator r3 = baked vertex color + ambient.xyz, alpha untouched.
	; Uniform must be src1 in add (PICA encoding restricts src2 to
	; temp/attribute), so ambient comes first.
	add r3.xyz, ambient[0], inclr
	mov r3.w,   inclr

	; Worldspace vertex pos in r2.xyz (lighting reads r2)
	mov r2.xyz, r1

	; --- Light 0 ---
	; Linear falloff matches lights.c::XLight1Group: attenuation =
	; max(0, 1 - dist²/Size²); contribution = color × attenuation.
	add r4.xyz, lights[0], -r2
	dp3 r5.x, r4, r4
	mul r5.x, lights[0].wwww, r5
	add r5.x, ones, -r5
	max r5.x, zeros, r5
	mul r6.xyz, lights[1], r5.xxxx
	add r3.xyz, r6, r3

	; --- Light 1 ---
	add r4.xyz, lights[3], -r2
	dp3 r5.x, r4, r4
	mul r5.x, lights[3].wwww, r5
	add r5.x, ones, -r5
	max r5.x, zeros, r5
	mul r6.xyz, lights[4], r5.xxxx
	add r3.xyz, r6, r3

	; --- Light 2 ---
	add r4.xyz, lights[6], -r2
	dp3 r5.x, r4, r4
	mul r5.x, lights[6].wwww, r5
	add r5.x, ones, -r5
	max r5.x, zeros, r5
	mul r6.xyz, lights[7], r5.xxxx
	add r3.xyz, r6, r3

	; --- Light 3 ---
	add r4.xyz, lights[9], -r2
	dp3 r5.x, r4, r4
	mul r5.x, lights[9].wwww, r5
	add r5.x, ones, -r5
	max r5.x, zeros, r5
	mul r6.xyz, lights[10], r5.xxxx
	add r3.xyz, r6, r3

	; --- Light 4 ---
	add r4.xyz, lights[12], -r2
	dp3 r5.x, r4, r4
	mul r5.x, lights[12].wwww, r5
	add r5.x, ones, -r5
	max r5.x, zeros, r5
	mul r6.xyz, lights[13], r5.xxxx
	add r3.xyz, r6, r3

	; --- Light 5 ---
	add r4.xyz, lights[15], -r2
	dp3 r5.x, r4, r4
	mul r5.x, lights[15].wwww, r5
	add r5.x, ones, -r5
	max r5.x, zeros, r5
	mul r6.xyz, lights[16], r5.xxxx
	add r3.xyz, r6, r3

	; --- Light 6 ---
	add r4.xyz, lights[18], -r2
	dp3 r5.x, r4, r4
	mul r5.x, lights[18].wwww, r5
	add r5.x, ones, -r5
	max r5.x, zeros, r5
	mul r6.xyz, lights[19], r5.xxxx
	add r3.xyz, r6, r3

	; --- Light 7 ---
	add r4.xyz, lights[21], -r2
	dp3 r5.x, r4, r4
	mul r5.x, lights[21].wwww, r5
	add r5.x, ones, -r5
	max r5.x, zeros, r5
	mul r6.xyz, lights[22], r5.xxxx
	add r3.xyz, r6, r3

	; Saturate to [0,1] (light_count.x masks unused-light contribution
	; — CPU sets unused light slots to color=0/invSizeSq=0 so they're
	; effectively no-ops; light_count uniform reserved for future use)
	min r3.xyz, ones, r3
	max r3.xyz, zeros, r3

	; Output
	mov outclr, r3
	mov outtc0, intex

	end
.end
