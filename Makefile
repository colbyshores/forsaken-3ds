#
# General Compiler Settings
#

# for cross compiling be sure to specify your compiler ex:
# make CXX=i686-w64-mingw32-g++

# general compiler settings
ifeq ($(M32),1)
  FLAGS+= -m32
endif
FLAGS+= -pipe
# -Wno-missing-field-initializers: the menu tables and the Vulkan create-info
# initialisers name the leading members and rely on the rest being zero.
CFLAGS=$(FLAGS) -Wall -Wextra -Wno-missing-field-initializers
LDFLAGS=$(FLAGS)

# right now non debug build would probably crash anyway
# we even release debug builds as the official release
DEBUG=1

# might as well leave gprof support on by default as well
PROFILE=1

# stack-smash protection against buffer overflows and corrupt pointers
# (enabled by default on many systems today)
ifeq ($(SSP),1)
  FLAGS+= -fstack-protector-all
  CFLAGS+= -D_FORTIFY_SOURCE=2
endif

ifeq ($(DEBUG),1)
  FLAGS+= -g
else
  CFLAGS+=-O3 -Winit-self
  LDFLAGS+=-s
endif

ifeq ($(PROFILE),1)
  ifneq ($(DEBUG),1)
    # Debug symbols needed for profiling to be useful
    FLAGS+= -g
  endif
  FLAGS+= -pg
endif

#
# ProjectX Specific
#

# some systems use lua5.1
LUA=$(shell pkg-config --exists lua5.1 && echo lua5.1 || echo lua)

# SDL2 only (Linux desktop backend)
SDL=2
ifeq ($(SDL),1)
  SDL_=sdl
else
  SDL_=sdl$(SDL)
endif


# library headers
CFLAGS+= `pkg-config --cflags $(SDL_) $(LUA) $(LUA)-socket libenet libpng zlib openal`

# libraries (Linux host only)
LIB+= `pkg-config --libs $(LUA) $(LUA)-socket libenet libpng zlib openal` -lm
LIB+= `pkg-config --libs $(SDL_)`
LIB+= -lvulkan -ldl

# Source trees (same shape as t2k / mdk-sdl): forsaken_core/src is the game
# and is compiled into both targets; forsaken_pc/src is the desktop layer.
# Includes are root-relative to a tree ("game/ships.h", "audio/sound.h").
CORE_SRCDIR=forsaken_core/src
PLAT_SRCDIR=forsaken_pc/src
SRC_DIRS:=$(sort $(shell find $(CORE_SRCDIR) $(PLAT_SRCDIR) -type d))
CFLAGS += -I$(CORE_SRCDIR) -I$(PLAT_SRCDIR)

# ProjectX-specific macros
CFLAGS+= -DNET_ENET_2 -DBSP -DLUA_USE_APICHECK -DTEXTURE_PNG -DSOUND_SUPPORT -DSOUND_OPENAL
ifeq ($(DEBUG),1)
  CFLAGS+= -DDEBUG_ON -DDEBUG_COMP -DDEBUG_SPOTFX_SOUND -DDEBUG_VIEWPORT
endif




# Objects go to $(BUILD_PC)/<basename>.o; basenames are unique across trees.
BUILD_PC=build_pc
vpath %.cpp $(SRC_DIRS)
INC=$(foreach d,$(SRC_DIRS),$(wildcard $(d)/*.h))
# Every translation unit is C++ (C with classes, AGENTS.md S9); the
# phase-2 language restrictions mean banned constructs must not compile.
CXXSRC=$(filter-out render_d3d.cpp breakpad.cpp,$(sort $(notdir $(foreach d,$(SRC_DIRS),$(wildcard $(d)/*.cpp)))))
CXXOBJ=$(patsubst %.cpp,$(BUILD_PC)/%.o,$(CXXSRC))
OBJ=$(CXXOBJ)
CXXFLAGS=$(CFLAGS) -std=gnu++17 -fno-exceptions -fno-rtti -fno-threadsafe-statics

# allows user to override settings
ADD_FLAGS=
ADD_CFLAGS=
ADD_LDFLAGS=
FLAGS+=$(ADD_FLAGS)
CFLAGS+=$(ADD_CFLAGS)
LDFLAGS+=$(ADD_LDFLAGS)

# Content edition, same convention as Makefile.3ds: EDITION=remaster
# (default) defines EDITION_REMASTER; EDITION=original defines nothing.
EDITION ?= remaster
ifeq ($(EDITION),remaster)
  CFLAGS+= -DEDITION_REMASTER
endif

# Level lists: assets/level_orderings/ is the single source of truth for
# both builds (Makefile.3ds stages the same files into the romfs).
# Installed into Data/levels/ for the edition being built; copied on
# every build so an edition switch always takes effect.
ifeq ($(EDITION),remaster)
LEVEL_LISTS_SRC := assets/level_orderings
LEVEL_LISTS := mission.dat battle.dat
else
LEVEL_LISTS_SRC := assets/level_orderings/original
LEVEL_LISTS := mission.dat
endif

BIN=projectx
CXX?=g++
.DEFAULT_GOAL := all

# ETC2 texture pack for the PC (Vulkan) build: every opaque PNG master
# under Data/ gets a .ktx2 sibling (ETC2, build-time encoded). Masters
# with meaningful alpha exit 2 in the encoder and stay on the RGBA
# path - they are the designated RGBA exception class. Generated files
# are gitignored; masters are the source of truth.
ETC2ENC=tools/texture/etc2enc
PNG_TEXTURES:=$(shell find Data -name '*.png' 2>/dev/null)
KTX2_TEXTURES:=$(PNG_TEXTURES:.png=.ktx2)

# Vulkan shaders: GLSL -> SPIR-V at build time, embedded via xxd. xxd runs
# from forsaken_pc/ so the generated symbol names are unchanged.
SHADER_DIR=forsaken_pc/shaders
SHADER_SPV=$(SHADER_DIR)/vulkan3d.vert.spv $(SHADER_DIR)/vulkan2d.vert.spv $(SHADER_DIR)/vulkan.frag.spv
VULKAN_SHADERS_H=$(PLAT_SRCDIR)/rendering/vulkan_shaders.h

$(SHADER_DIR)/%.spv: $(SHADER_DIR)/%
	glslangValidator -V $< -o $@

$(VULKAN_SHADERS_H): $(SHADER_SPV)
	@( cd forsaken_pc && echo '// generated by Makefile from shaders/*.spv - do not edit'; \
	  xxd -i shaders/vulkan3d.vert.spv; \
	  xxd -i shaders/vulkan2d.vert.spv; \
	  xxd -i shaders/vulkan.frag.spv ) > $@
	sed -i 's/shaders_vulkan3d_vert_spv/vulkan3d_vert_spv/g; s/shaders_vulkan2d_vert_spv/vulkan2d_vert_spv/g; s/shaders_vulkan_frag_spv/vulkan_frag_spv/g' $@

$(BUILD_PC)/render_vulkan.o: $(VULKAN_SHADERS_H)

$(ETC2ENC): tools/texture/etc2enc.c
	cc -O2 -o $@ $< -lpng -lm

%.ktx2: %.png $(ETC2ENC)
	@$(ETC2ENC) $< $@ || { rc=$$?; rm -f $@; test $$rc -eq 2; }

textures-etc2: $(KTX2_TEXTURES)

all: textures-etc2 level-lists $(BIN)

level-lists:
	@mkdir -p Data/levels
	@for f in $(LEVEL_LISTS); do \
		cmp -s $(LEVEL_LISTS_SRC)/$$f Data/levels/$$f || cp -f $(LEVEL_LISTS_SRC)/$$f Data/levels/$$f; \
	done

$(BIN): $(OBJ)
	$(CXX) -o $(BIN) $(OBJ) $(LDFLAGS) $(LIB)

$(BUILD_PC)/%.o: %.cpp $(INC)
	@mkdir -p $(BUILD_PC)
	$(CXX) $(CXXFLAGS) -c -o $@ $<

$(OBJ): $(INC)

clean:
	$(RM) $(OBJ) $(BIN) $(VULKAN_SHADERS_H)

check:
	@echo
	@echo "INC = $(INC)"
	@echo
	@echo "SRC = $(CXXSRC)"
	@echo
	@echo "OBJ = $(OBJ)"
	@echo
	@echo "DEBUG = $(DEBUG)"
	@echo "PROFILE = $(PROFILE)"
	@echo "PKG_CFG_OPTS = $(PKG_CFG_OPTS)"
	@echo "GL = $(GL)"
	@echo "LUA = $(LUA)"
	@echo "SDL = $(SDL)"
	@echo "SDL_ = $(SDL_)"
	@echo
	@echo "CXX = $(CXX)"
	@echo "BIN = $(BIN)"
	@echo "CXXFLAGS = $(CXXFLAGS)"
	@echo "LDFLAGS = $(LDFLAGS)"
	@echo "LIB = $(LIB)"
	@echo

.PHONY: all clean level-lists
