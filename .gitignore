# ============================================================
# ForsakenX 3DS Port — .gitignore
# Only code, headers, configs, makefiles, and docs are tracked.
# ============================================================

# ---- Compiled objects and binaries ----
*.o
*.a
*.so
*.dll
*.exe
*.elf
*.3dsx
*.smdh
*.map
*.bin
*.cia
gmon.out

# ---- Build output: everything make writes (3DS, PC, build matrix) ----
/build/
forsaken_*.log

# ---- PC build artifacts ----
libs*
unix*
mingw*

# ---- Game data / assets (large binaries, not code) ----
# Retail game data directories (textures, models, sounds, levels)
/data/
/pilots/
romfs/
savegame/
logs/
# The original 1998 CD's files (audio rips, installer data, demos)
/cd/

# Level lists live in assets/level_orderings/ (Remaster) and
# assets/level_orderings/original/ (1998), tracked normally; both
# Makefiles install the edition's lists (romfs staging on 3DS,
# data/levels/ on PC).

# Config directory: only configs/main.txt is tracked.
configs/

# ---- Asset file types ----
*.bmp
*.BMP
*.png
*.PNG
*.jpg
*.jpeg
*.gif
*.tga
*.pcx
*.ico
*.wav
*.WAV
*.mp3
*.ogg
*.mid
*.ppm
*.PPM

# ---- Model / level data ----
*.mx
*.mxa
*.cob
*.dat

# ---- picaGL (separate submodule/repo) ----
picaGL/

# ---- IDE and editor files ----
*.vcxproj*
*.sln
*.suo
*.user
*.swp
*.swo
*~
.vscode/
.idea/

# ---- Shell scripts (development utilities) ----
*.sh

# ---- Misc ----

# ---- Exceptions: tracked files that match patterns above ----
# Lua game scripts (code, not assets)
!scripts/
!scripts/**
# The shipped default config
!configs/
!configs/main.txt
# CI workflows
!.github/
!.github/**

# CIA build pipeline — fetched binaries (run `make tools-fetch`)
# Ignore everything in tools/ EXCEPT tracked Python helpers (the
# fetched binaries — makerom, bannertool, the enet-build clone, etc.
# — stay out of version control).
tools/*
!tools/build_matrix.sh
!tools/verify_identical.sh
!tools/verify_o0.sh
!tools/*.py
# Perf-contract tooling (AGENTS.md gates) is tracked source, not fetched
# binaries. Baselines inside it are tracked adoption debt — never let the
# tools/* rule swallow them. Run logs stay out.
!tools/perf/
!tools/perf/**
!tools/texture/
!tools/texture/*.c
!tools/texture/*.py
!tools/texture/*.sh
# Asset pipeline scripts and the small 3DS test programs.
!tools/assets/
!tools/assets/**
!tools/probe/
!tools/probe/Makefile
!tools/probe/*.c
!tools/probe/*.rsf
tools/probe/build/
!tools/net_test/
!tools/net_test/**/
!tools/net_test/**/Makefile
!tools/net_test/**/*.c
tools/perf/logs/

# Nintendo DSP firmware blob. NOT bundled in the CIA — CFW users on real
# hardware already have sdmc:/3ds/dspfirm.cdc from the standard DSP1 dump
# (zoogie's tool). It IS bundled in the .3dsx so emulator testing has
# audio out of the box; ensure_dspfirm_on_sd() auto-copies it to the
# virtual SD on first launch. Dump from your own 3DS and place at this
# path before building the .3dsx. Never commit this file to any
# repository — public or otherwise.
assets/dspfirm.cdc

# Build artifacts
*.cia
*.bnr

# Python bytecode caches (from extract/regen helper scripts)
__pycache__/
*.pyc

# HD-texture intermediate output (scratch from older runs of the regen
# pipeline; current pipeline writes to romfs/hd_old/ which IS tracked-as-
# absent via romfs/ rules)
romfs_hd/

# Per-developer debug overlay (configs/debug.txt locally; never commit)
configs/debug.txt

# CIA build assets (small + needed to build the .cia)
!assets/icon.png
!assets/banner.png
!assets/banner.wav
forsaken_stereo.txt

# Pi harness progress checkpoints (pi's 5-turn crash-recovery files, repo-local)
/PROGRESS.md
/.progress-log/

# build-time ETC2 pack (from PNG masters)
data/**/*.ktx2
tools/texture/etc2enc
forsaken_pc/shaders/*.spv
forsaken_pc/src/rendering/vulkan_shaders.h

# Host test binaries and their outputs (tests/Makefile builds them in place).
tests/*
!tests/Makefile
!tests/*.cpp
!tests/*.c

# Animated banner pipeline (banner/SPEC.md): tools and build output
/banner/.tools/
/banner/build/
/banner/test_app/build/
/banner/test_app/build_cia/
/banner/test_app/romfs/
# ...but the banner's own sources are tracked: its art (.png), scripts (.sh)
# and the approved packed banner (.bnr) would otherwise be caught above.
!/banner/**/*.png
!/banner/**/*.sh
!/banner/*.bnr
